# Production template — copy to .env.production and fill values
# Deploy hosting par ye variables set karo (file commit mat karo)

NIXPACKS_NODE_VERSION=20
NEXT_PUBLIC_APP_URL=https://uhired.in
# Base URL for interview links inside outbound email (required if APP_URL is localhost in dev).
INVITE_EMAIL_BASE_URL=https://uhired.in

# Prisma uses these to talk to Supabase Postgres
# Runtime: Supabase transaction pooler (port 6543). connection_limit=1 is OK on Vercel;
# Coolify/Docker auto-raises it to 5 at runtime (override with DATABASE_CONNECTION_LIMIT).
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require
# Migrations: direct host — NOT the pooler URL
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require

ADMIN_PORTAL_KEY=change-me
MASTER_ADMIN_KEY=change-me-master
MASTER_ADMIN_EMAIL=master@uhired.com
MASTER_ADMIN_PASSWORD=change-me-master

OPENAI_API_KEY=replace-with-openai-key
SCORING_MODE=rubric
SCORING_MODEL=gpt-4.1-mini
VOICE_TTS_PROVIDER=openai
ELEVENLABS_API_KEY=
PRACTICE_BASE_PRICE_RUPEES=25

RAZORPAY_KEY_ID=rzp_test_xxxxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=replace-with-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-webhook-secret

SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_STORAGE_BUCKET=uhired-videos

VIDEO_STORAGE_PROVIDER=s3
AWS_REGION=ap-south-1
AWS_S3_BUCKET=uhired-videos
AWS_ACCESS_KEY_ID=replace-with-aws-key
AWS_SECRET_ACCESS_KEY=replace-with-aws-secret
AWS_S3_ENDPOINT=

# Email — production/staging must deliver to real inboxes (not Mailpit/Mailtrap).
# Option A (recommended): AWS SES API using existing AWS credentials + verified domain.
EMAIL_PROVIDER=ses
SMTP_FROM=Uhired <no-reply@uhired.in>
SMTP_FROM_EMAIL=no-reply@uhired.in
SMTP_FROM_NAME=Uhired
# Monitored inbox for Reply-To (create support@uhired.in in GoDaddy Email).
SUPPORT_EMAIL=support@uhired.in
INVITE_EMAIL_BASE_URL=https://uhired.in
SMTP_SEND_DELAY_MS=1500
SMTP_MAX_RETRIES=5
# Optional SES bounce/complaint tracking (production).
# SES_CONFIGURATION_SET=uhired-transactional

# Option B: AWS SES SMTP (set EMAIL_PROVIDER=smtp and use SES SMTP credentials).
# SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=replace-with-ses-smtp-user
# SMTP_PASS=replace-with-ses-smtp-pass
# SMTP_DELIVERY_MODE=live

# Option C (GoDaddy uhired.in): set EMAIL_PROVIDER=smtp and uncomment below.
# EMAIL_PROVIDER=smtp
# SMTP_DELIVERY_MODE=live
# SMTP_HOST=smtpout.secureserver.net
# SMTP_PORT=465
# SMTP_USER=no-reply@uhired.in
# SMTP_PASS=replace-with-mailbox-password
# SUPPORT_EMAIL=support@uhired.in
# INVITE_EMAIL_BASE_URL=https://uhired.in
# Titan Webmail → Settings → Enable Titan on Other Apps (required for SMTP).
