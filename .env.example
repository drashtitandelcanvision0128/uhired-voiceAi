# =============================================================================
# Copy to .env — same structure as production (future-ready)
# =============================================================================

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional PNG/JPG for PDF header (defaults to public/company-logo.png if present)
# COMPANY_LOGO_PATH=

# LOCAL (pgAdmin database "uhired") - commented out
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/uhired?schema=public&sslmode=disable
# DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/uhired?schema=public&sslmode=disable

# ACTIVE (Supabase Postgres): replace PROJECT_REF and PASSWORD with your actual values
# connection_limit=1 is for serverless only; use 15–20 for Docker / long-running Node.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=15&sslmode=require
# Override pool size for 30+ parallel interviews (Docker/Coolify):
# DATABASE_CONNECTION_LIMIT=20
# DATABASE_POOL_TIMEOUT=30
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require

ADMIN_PORTAL_KEY=change-me
MASTER_ADMIN_KEY=change-me-master
# Dedicated session signing secrets (recommended in production; fall back to keys above if unset)
COMPANY_SESSION_SECRET=change-me-company-session
CANDIDATE_INTERVIEW_SESSION_SECRET=change-me-candidate-session
MASTER_SESSION_SECRET=change-me-master-session
MASTER_ADMIN_EMAIL=master@uhired.com
MASTER_ADMIN_PASSWORD=master@123
# Optional: development | staging | production (shown on master login badge)
APP_ENV=development

OPENAI_API_KEY=replace-with-openai-key
SCORING_MODE=rubric
SCORING_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small

# Voice TTS: openai (default) | elevenlabs (hybrid — OpenAI Realtime brain + ElevenLabs voice)
VOICE_TTS_PROVIDER=openai
ELEVENLABS_API_KEY=
# Optional voice overrides (defaults: Adam male, Rachel female)
# ELEVENLABS_VOICE_ID_MALE=pNInz6obpgDQGcFmaJgB
# ELEVENLABS_VOICE_ID_FEMALE=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

RAZORPAY_KEY_ID=rzp_test_xxxxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=replace-with-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-webhook-secret
PRACTICE_BASE_PRICE_RUPEES=25

# local | s3 (production)
VIDEO_STORAGE_PROVIDER=local

SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_STORAGE_BUCKET=uhired-videos

AWS_REGION=ap-south-1
AWS_S3_BUCKET=uhired-videos
AWS_ACCESS_KEY_ID=replace-with-aws-key
AWS_SECRET_ACCESS_KEY=replace-with-aws-secret
AWS_S3_ENDPOINT=

# Mailtrap sandbox (local dev) — https://mailtrap.io
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=replace-with-mailtrap-user
# SMTP_PASS=replace-with-mailtrap-pass

# GoDaddy Professional Email (uhired.in) — live SMTP for local invite testing
EMAIL_PROVIDER=smtp
SMTP_DELIVERY_MODE=live
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USER=no-reply@uhired.in
SMTP_PASS=replace-with-mailbox-password
SMTP_FROM_EMAIL=no-reply@uhired.in
SMTP_FROM_NAME=Uhired
SMTP_FROM=Uhired <no-reply@uhired.in>
# Use a monitored inbox for Reply-To — NOT no-reply (Gmail spam signal).
# Data retention (days) — optional overrides for cleanup job
# DATA_RETENTION_DAYS_VIDEO=30
# DATA_RETENTION_DAYS_TRANSCRIPT=90
# DATA_RETENTION_DAYS_PRACTICE=180
# Production invite links only (ignored in npm run dev — dev emails use localhost).
INVITE_EMAIL_BASE_URL=https://uhired.in
# Delay between each invite email (ms).
SMTP_SEND_DELAY_MS=1500
SMTP_MAX_RETRIES=5
# live | capture — auto-detected from host/port; override if needed.
# SMTP_DELIVERY_MODE=capture

# Production/staging: use AWS SES API (recommended when AWS keys are already set).
# When SMTP is Mailpit/Mailtrap and NODE_ENV=production, SES is used automatically.
# EMAIL_PROVIDER=ses

# -----------------------------------------------------------------------------
# Voice Activity Detection (optional — defaults match production tuning)
# Client reads NEXT_PUBLIC_*; server accepts VAD_* or NEXT_PUBLIC_*.
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_VAD_THRESHOLD=0.6
# NEXT_PUBLIC_VAD_SILENCE_BASE_MS=3000
# NEXT_PUBLIC_VAD_SILENCE_MIN_MS=2000
# NEXT_PUBLIC_VAD_SILENCE_MAX_MS=5000
# NEXT_PUBLIC_VAD_PREFIX_PADDING_MS=300
# NEXT_PUBLIC_VAD_SPEECH_CONFIRM_MS=160

# -----------------------------------------------------------------------------
# Transcript confidence validation (optional — defaults match production tuning)
# Reject ASR results below threshold and ask the candidate to repeat their answer.
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_TRANSCRIPTION_CONFIDENCE_THRESHOLD=0.5
# NEXT_PUBLIC_TRANSCRIPTION_CONFIDENCE_MAX_RETRIES=3

# -----------------------------------------------------------------------------
# Phase 7b — Enterprise (DISABLED by default — set PHASE_7B_ENABLED=true to enable)
# SSO, team RBAC UI, and permission guards. Phase 7 foundation (CSP, rate limit)
# stays active without this flag.
# -----------------------------------------------------------------------------
# PHASE_7B_ENABLED=false
# FIELD_ENCRYPTION_KEY=64-char-hex-or-any-secret-string
# REDIS_URL=redis://localhost:6379
# COMPANY_OIDC_ISSUER=https://login.microsoftonline.com/{tenant}/v2.0
# COMPANY_OIDC_CLIENT_ID=
# COMPANY_OIDC_CLIENT_SECRET=
# COMPANY_OIDC_REDIRECT_URI=http://localhost:3000/api/company-auth/oidc/callback
# COMPANY_OIDC_SCOPES=openid email profile
# COMPANY_OIDC_AUTO_PROVISION=RECRUITER
