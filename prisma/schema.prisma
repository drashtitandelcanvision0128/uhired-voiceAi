// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum InterviewerVoiceGender {
  MALE
  FEMALE
}

model PromoCode {
  id              String    @id @default(cuid())
  code            String    @unique
  durationMin     Int
  isActive        Boolean   @default(true)
  recipientEmail  String?
  companyName     String?
  emailSentAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Company {
  id                 String               @id @default(cuid())
  name               String               @unique
  domain             String
  adminEmail         String
  adminPasscode      String
  interviewerName    String?
  interviewerVoiceGender InterviewerVoiceGender @default(MALE)
  brandDisplayName     String?
  brandPrimaryColor    String?
  brandLogoUrl         String?
  interviewLanguage    String               @default("en")
  atsWebhookUrl        String?
  atsWebhookSecret     String?
  isActive           Boolean              @default(true)
  sessions           InterviewSession[]
  requirements       Requirement[]
  candidates         Candidate[]
  scorecardShareLinks  ScorecardShareLink[]
  requirementInvites RequirementInvite[]
  members            CompanyMember[]
  observerLinks      InterviewObserverLink[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

model Requirement {
  id                   String             @id @default(cuid())
  companyId            String
  company              Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accessCode           String?            @unique
  title                String?
  domain               String
  topic                String
  durationMin          Int
  jobDescription       String?
  keySkills            Json?
  maxOptionalQuestions Int                @default(0)
  interviewLanguage    String?
  isArchived           Boolean            @default(false)
  sessions             InterviewSession[]
  questions            RequirementQuestion[]
  invites              RequirementInvite[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model RequirementInvite {
  id            String      @id @default(cuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  companyId     String
  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email         String
  candidateName String?
  source        String      @default("email")
  accessCode    String      @unique
  scheduledAt   DateTime?
  emailSentAt   DateTime?
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([requirementId, email])
  @@index([companyId])
}

model RequirementQuestion {
  id             String      @id @default(cuid())
  requirementId  String
  prompt         String
  expectedAnswer String?
  gradingRubric  String?
  difficulty     String      @default("medium")
  orderIndex     Int
  isMandatory    Boolean     @default(true)
  requirement    Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
}

model Candidate {
  id          String             @id @default(cuid())
  companyId   String
  company     Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  email       String?
  isArchived  Boolean            @default(false)
  sessions    InterviewSession[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([companyId, email])
}

model InterviewSession {
  id              String           @id @default(cuid())
  accessCode      String           @unique
  sessionType     SessionType
  status          SessionStatus    @default(READY)
  candidateName   String?
  candidateEmail  String?
  candidateId     String?
  candidate       Candidate?      @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  domain          String
  topic           String
  durationMin     Int
  companyName     String?
  companyId       String?
  company         Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  requirementId   String?
  requirement     Requirement?     @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  positionTitle   String?
  jobDescription  String?
  keySkills       Json?
  sessionArchivedAt DateTime?
  requirementArchivedAt DateTime?
  maxOptionalQuestions Int @default(0)
  pickedOptionalQuestionIds Json?
  isPaid          Boolean          @default(false)
  promoCode       String?
  startedAt       DateTime?
  endedAt         DateTime?
  consentAcceptedAt DateTime?
  consentVersion  String?
  dataAnonymizedAt DateTime?
  practicePayment PracticePayment?
  transcript           InterviewTurn[]
  questions            InterviewQuestion[]
  scorecard            Scorecard?
  scoringJobs          ScoringBatchJob[]
  scorecardShareLinks  ScorecardShareLink[]
  observerLinks        InterviewObserverLink[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
}

model InterviewObserverLink {
  id        String           @id @default(cuid())
  sessionId String
  session   InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  companyId String
  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tokenHash String           @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime         @default(now())

  @@index([sessionId])
  @@index([companyId])
}

model CandidatePortalOtp {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model ScorecardShareLink {
  id                     String           @id @default(cuid())
  tokenHash              String           @unique
  sessionId              String
  session                InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  companyId              String
  
  company                Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  expiresAt              DateTime
  revokedAt              DateTime?
  includeCandidateName   Boolean          @default(false)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  @@index([sessionId])
  @@index([companyId])
}

model InterviewQuestion {
  id             String           @id @default(cuid())
  sessionId      String
  prompt         String
  expectedAnswer String?
  gradingRubric  String?
  difficulty     String           @default("medium")
  orderIndex     Int
  isMandatory    Boolean          @default(true)

  session        InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model InterviewTurn {
  id                      String           @id @default(cuid())
  sessionId               String
  speaker                 TurnSpeaker
  message                 String
  orderIndex              Int              @default(0)
  /** Milliseconds from interview start when this utterance began (client clock). */
  timestampMs             Int?
  /** ASR confidence 0–1 for candidate speech-to-text turns. */
  transcriptionConfidence Float?
  createdAt               DateTime         @default(now())
  session                 InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model Scorecard {
  id            String           @id @default(cuid())
  sessionId     String           @unique
  session       InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  overallScore  Int
  communication Int
  domainDepth   Int
  confidence    Int
  summary       String
  strengths     Json?
  improvements  Json?
  evidence          Json?
  accuracyPercent   Int?
  questionResults   Json?
  scoringMode       String?          @default("heuristic")
  scoringModel      String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model ScoringBatchJob {
  id           String           @id @default(cuid())
  sessionId    String
  session      InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  status       ScoringJobStatus @default(PENDING)
  batchId      String?
  inputPayload Json
  resultPayload Json?
  error        String?
  retryCount   Int              @default(0)
  submittedAt  DateTime?
  completedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([sessionId, createdAt])
  @@index([batchId, status])
}

model DataDeletionRequest {
  id          String                   @id @default(cuid())
  email       String
  reason      String?                  @db.Text
  status      DataDeletionRequestStatus @default(PENDING)
  clientIp    String?
  processedAt DateTime?
  resultNote  String?                  @db.Text
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@index([email])
  @@index([status, createdAt])
}

enum DataDeletionRequestStatus {
  PENDING
  PROCESSED
  REJECTED
}

model PracticePayment {
  id             String        @id @default(cuid())
  orderId        String        @unique
  paymentId      String?       @unique
  signature      String?
  amountPaise    Int
  currency       String        @default("INR")
  status         PaymentStatus @default(CREATED)
  candidateName  String
  candidateEmail String
  domain         String
  topic          String
  durationMin    Int
  promoCode      String?
  sessionId      String?       @unique
  session        InterviewSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model SupportInquiry {
  id        String               @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String               @db.Text
  source    SupportInquirySource @default(PUBLIC_CONTACT)
  status    SupportInquiryStatus @default(NEW)
  clientIp  String?
  readAt    DateTime?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([createdAt])
  @@index([status])
  @@index([email])
}

enum SupportInquirySource {
  PUBLIC_CONTACT
  COMPANY_ADMIN
}

enum SupportInquiryStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

model MasterLoginEvent {
  id          String   @id @default(cuid())
  email       String
  success     Boolean
  clientIp    String?
  userAgent   String?
  trustDevice Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([email, success])
}

model MasterAdminAccount {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PlatformAuditLog {
  id        String   @id @default(cuid())
  level     String
  category  String
  title     String
  message   String   @db.Text
  actor     String   @default("system")
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([category])
  @@index([level])
}

enum SessionType {
  PRACTICE
  COMPANY
}

enum SessionStatus {
  READY
  LIVE
  COMPLETED
}

enum TurnSpeaker {
  CANDIDATE
  INTERVIEWER
}

enum PaymentStatus {
  CREATED
  VERIFIED
  FAILED
  REFUNDED
}

enum ScoringJobStatus {
  PENDING
  SUBMITTED
  COMPLETED
  FAILED
}

enum ContentPageType {
  BLOG
  JOB
}

model ContentPage {
  id             String          @id @default(cuid())
  type           ContentPageType
  slug           String?         @unique
  title          String
  excerpt        String?
  body           String
  coverImageUrl  String?
  seoTitle       String?
  seoDescription String?
  location       String?
  employmentType String?
  isPublished    Boolean         @default(false)
  publishedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([type, isPublished])
}

enum CompanyMemberRole {
  ADMIN
  RECRUITER
  HIRING_MANAGER
  VIEWER
}

model CompanyMember {
  id          String            @id @default(cuid())
  companyId   String
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email       String
  name        String?
  role        CompanyMemberRole @default(RECRUITER)
  isActive    Boolean           @default(true)
  ssoSubject  String?
  lastLoginAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([companyId, email])
  @@index([email])
  @@index([companyId, role])
}
