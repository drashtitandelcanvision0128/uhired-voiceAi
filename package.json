{
  "name": "interview-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:baseline": "node scripts/baseline-migrations.mjs",
    "db:migrate:deploy:prod": "node scripts/migrate-prod.mjs",
    "db:migrate:status": "prisma migrate status",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:hash:company-passcodes": "node scripts/hash-company-passcodes.mjs",
    "sessions:abandon-stuck": "node --env-file=.env scripts/abandon-stuck-sessions.mjs",
    "data:retention:cleanup": "npx tsx scripts/data-retention-cleanup.mjs",
    "test:privacy": "npx tsx --import ./scripts/stubs/register-server-only-stub.mjs --env-file=.env scripts/test-privacy-phase6.mjs",
    "test:privacy:api": "npx tsx --import ./scripts/stubs/register-server-only-stub.mjs --env-file=.env scripts/test-privacy-api-integration.mjs",
    "test:polish": "npx tsx --import ./scripts/stubs/register-server-only-stub.mjs --env-file=.env scripts/test-phase2-polish-apis.mjs",
    "test:enterprise": "npx tsx --import ./scripts/stubs/register-server-only-stub.mjs --env-file=.env scripts/test-phase7b-enterprise.mjs",
    "test:load": "npx tsx --env-file=.env scripts/test-concurrent-load.mjs",
    "db:backfill:company-members": "npx tsx --env-file=.env scripts/backfill-company-members.mjs",
    "db:import:sqltables": "node scripts/import-sqltables.mjs",
    "db:seed:bootstrap": "node scripts/seed-production-bootstrap.mjs",
    "db:seed:dev-admin": "node scripts/seed-dev-admin.mjs",
    "storage:backfill:supabase-to-s3": "node scripts/backfill-videos-supabase-to-s3.mjs",
    "scoring:batch:submit": "node scripts/scoring-batch-submit.mjs",
    "scoring:batch:sync": "node scripts/scoring-batch-sync.mjs",
    "test:interview:unit": "npx tsx scripts/test-interview-conversation-state.mjs && npx tsx scripts/test-speech-transcription.mjs && npx tsx scripts/test-interview-silence-fallback.mjs && npx tsx scripts/test-transcript-confidence-validation.mjs && npx tsx scripts/test-voice-activity-detection.mjs",
    "test:interview:e2e": "npx tsx --env-file=.env scripts/qa-interview-e2e-comprehensive.mjs",
    "test:interview:e2e:browser": "npx tsx --env-file=.env scripts/qa-interview-e2e-comprehensive.mjs",
    "test:interview:all": "npx tsx --env-file=.env scripts/run-interview-e2e-suite.mjs",
    "test:qa": "node scripts/run-qa-suite.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1033.0",
    "@aws-sdk/client-ses": "^3.1096.0",
    "@aws-sdk/s3-request-presigner": "^3.1033.0",
    "@mediapipe/tasks-vision": "^0.10.35",
    "@prisma/client": "^6.18.0",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.0",
    "@supabase/supabase-js": "^2.104.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.0",
    "lucide-react": "^1.8.0",
    "next": "16.2.3",
    "nodemailer": "^9.0.0",
    "openai": "^6.34.0",
    "pdf-lib": "^1.17.1",
    "razorpay": "^2.9.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "redis": "^4.7.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "docx": "^9.7.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "playwright": "^1.62.1",
    "prisma": "^6.18.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
